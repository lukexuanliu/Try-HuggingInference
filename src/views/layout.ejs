<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hugging Face LLM Demo</title>
    <!-- Bootstrap Dark Theme -->
    <link rel="stylesheet" href="https://cdn.replit.com/agent/bootstrap-agent-dark-theme.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/custom.css">
</head>
<body>
    <header class="bg-primary text-white py-3 mb-4">
        <div class="container">
            <div class="d-flex align-items-center">
                <h1 class="h3 mb-0">Hugging Face LLM Demo</h1>
            </div>
        </div>
    </header>

    <main class="container">
        <%- body %>
    </main>

    <footer class="mt-5 py-3 bg-secondary-subtle text-center">
        <div class="container">
            <p class="small text-body-secondary">
                Hugging Face LLM Demo - TypeScript Version
            </p>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom JS -->
    <%- typeof scripts !== 'undefined' ? scripts : '' %>
</body>
</html>